# 资源路径配置（复制本文件为 broker.env 后修改；broker.env 不进 git）
# 指哪加载哪：dev/build 启动时把下面三个路径的内容同步进站点
# 注意：没有任何内置排除——目录里有什么就发布什么，敏感内容自己把关

# 笔记目录（md，最多两级分类：分类/子分类/笔记.md，图片放同目录 assets/）
NOTES_PATH=D:/javall/javaLearn/broker-resource/notes

# 文章目录（md + txt；txt 构建时原样转 md，与 md 同名时 txt 跳过）
ARTICLES_PATH=D:/javall/javaLearn/broker-resource/articles

# 收藏网站数据文件（JSON，结构如下；desc 可省略）
# [
#   { "name": "分组名",
#     "sites": [ { "name": "GitHub", "url": "https://github.com", "desc": "代码托管" } ] }
# ]
STAR_URL_PATH=D:/javall/javaLearn/broker-resource/starUrl.txt
